---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orbit Reversal Dodge</title>
    <meta
      name="description"
      content="A one-button orbit game: tap, click, or press any key to reverse direction and dodge hazards on the ring. Survive as long as you can."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1 class="sr-only">Orbit Reversal Dodge</h1>
      <canvas id="game" aria-hidden="true"></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
